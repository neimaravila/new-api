+
+// Claude can report cache_creation_input_tokens without the ephemeral 5m/1h
+// split. The total must still be billed (at the default 5m TTL) instead of
+// silently dropping to zero; a reported split is kept and only an unsplit
+// remainder is added to 5m.
+func TestBuildTieredTokenParams_ClaudeUnsplitCacheCreation(t *testing.T) {
+	expr := `tier("base", p * 3 + c * 15 + cr * 0.3 + cc * 3.75 + cc1h * 6)`
+	usedVars := billingexpr.UsedVars(expr)
+	for _, tc := range []struct {
+		name     string
+		total    int
+		split5m  int
+		split1h  int
+		wantCC   float64
+		wantCC1h float64
+	}{
+		{"total without split", 1200, 0, 0, 1200, 0},
+		{"full split", 1500, 1000, 500, 1000, 500},
+		{"partial split", 1500, 0, 500, 1000, 500},
+		{"no cache creation", 0, 0, 0, 0, 0},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			usage := &dto.Usage{
+				PromptTokens:     5000,
+				CompletionTokens: 2000,
+				UsageSemantic:    "anthropic",
+				PromptTokensDetails: dto.InputTokenDetails{
+					CachedCreationTokens: tc.total,
+				},
+				ClaudeCacheCreation5mTokens: tc.split5m,
+				ClaudeCacheCreation1hTokens: tc.split1h,
+			}
+			params := BuildTieredTokenParams(usage, true, usedVars)
+			assert.Equal(t, tc.wantCC, params.CC)
+			assert.Equal(t, tc.wantCC1h, params.CC1h)
+		})
+	}
+}
