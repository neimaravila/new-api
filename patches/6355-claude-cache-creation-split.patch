 	cc1h := float64(0)
 
 	if usage.UsageSemantic == "anthropic" {
+		// Claude may report cache_creation_input_tokens without the 5m/1h
+		// split; the unsplit remainder is billed at the default 5m TTL.
 		cc1h = float64(usage.ClaudeCacheCreation1hTokens)
 		cc5m = float64(usage.ClaudeCacheCreation5mTokens)
