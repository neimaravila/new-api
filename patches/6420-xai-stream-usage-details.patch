From 3df6313cd0d0be8f887a1cb364359dbf436924e1 Mon Sep 17 00:00:00 2001
From: leon <a1-6@1-6deMacBook-Air.local>
Date: Thu, 23 Jul 2026 08:20:30 -0400
Subject: [PATCH] fix(xai): preserve token details in stream usage conversion
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

xAIStreamHandler only copied prompt_tokens/total_tokens/completion_tokens
when converting the xAI stream usage, dropping prompt_tokens_details
(cached_tokens) and completion_tokens_details. As a result cached tokens
from streaming grok requests never reach the log, and cache pricing is
never applied — cached prompt tokens are billed at the full input rate.
Non-stream requests already keep these fields via xAIHandler.

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
---
 relay/channel/xai/text.go | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/relay/channel/xai/text.go b/relay/channel/xai/text.go
index f9a8ee2e6f9..997f170ddd4 100644
--- a/relay/channel/xai/text.go
+++ b/relay/channel/xai/text.go
@@ -57,6 +57,8 @@ func xAIStreamHandler(c *gin.Context, info *relaycommon.RelayInfo, resp *http.Re
 			usage.PromptTokens = xAIResp.Usage.PromptTokens
 			usage.TotalTokens = xAIResp.Usage.TotalTokens
 			usage.CompletionTokens = usage.TotalTokens - usage.PromptTokens
+			usage.PromptTokensDetails = xAIResp.Usage.PromptTokensDetails
+			usage.CompletionTokenDetails = xAIResp.Usage.CompletionTokenDetails
 		}
 
 		openaiResponse := streamResponseXAI2OpenAI(xAIResp, usage)
