+// finishContentBlocks closes every open content block before message_delta.
+// Anthropic requires at least one non-thinking content block per message, so
+// a stream that emitted no text or tool_use block (e.g. a reasoning model that
+// spent max_tokens on thinking) gets an empty text block.
+func finishContentBlocks(state *convmeta.ClaudeConvertInfo) []*dto.ClaudeResponse {
+	responses := startPendingToolBlocks(state)
+	responses = append(responses, stopOpenBlocks(state)...)
+	if state.HasContentBlock {
+		return responses
+	}
+	textIndex := state.Index
+	if state.LastMessagesType != convmeta.LastMessageTypeNone {
+		textIndex++
+	}
+	responses = append(responses,
+		&dto.ClaudeResponse{
+			Index: kitutil.GetPointer[int](textIndex),
+			Type:  "content_block_start",
+			ContentBlock: &dto.ClaudeMediaMessage{
+				Type: "text",
+				Text: kitutil.GetPointer[string](""),
+			},
+		},
+		generateStopBlock(textIndex),
+	)
+	state.HasContentBlock = true
+	return responses
+}
